<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_users_form_pos_refund_restriction" model="ir.ui.view">
        <field name="name">res.users.form.pos.refund.restriction</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='preferences']" position="before">
                <page string="Point of Sale"
                      name="pos_refund_restriction"
                      groups="base.group_system">
                    <group string="Hak Retur">
                        <field name="allow_pos_refund"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
